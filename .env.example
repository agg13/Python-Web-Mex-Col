# Copiar como .env únicamente en el equipo local.
SECRET_KEY=cambiar-por-un-valor-local-largo-y-aleatorio
FLASK_DEBUG=true
HOST=127.0.0.1
PORT=5001

# TODO SESIÓN 2: comprobar primero el modo memory y cambiarlo a database
# cuando PostgreSQL esté disponible.
DATA_MODE=memory

# TODO SESIÓN 2: relacionar cada parte de esta URL con compose.yaml.
# No registrar credenciales reales en Git.
DATABASE_URL=postgresql+psycopg://taller_user:taller_password@localhost:5432/taller_store

# TODO SESIÓN 2: activar después de definir los modelos y la carga inicial.
AUTO_INIT_DB=false
